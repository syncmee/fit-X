# fiT-X configuration. Copy to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (omit DATABASE_URL to use the local SQLite file at instance/userdata.db)
# Supabase example (pooled connection, works over IPv4):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Session cookie SameSite policy (Lax / Strict / None)
SESSION_COOKIE_SAMESITE=Lax

# fiT-X AI coach — get a key at https://aistudio.google.com/
# Leave GEMINI_API_KEY empty to use the built-in rule-based coach instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Workout reminder emails via Resend (https://resend.com).
# Leave RESEND_API_KEY empty to run /cron/send-reminders in dry-run mode.
# RESEND_FROM needs a verified domain for deliveries beyond your own inbox.
RESEND_API_KEY=
RESEND_FROM=fiT-X <onboarding@resend.dev>

# Shared secret for the scheduler -> /cron/send-reminders trigger.
# Must match the FITX_CRON_SECRET repo secret used by .github/workflows/reminders.yml
CRON_SECRET=
