# fiT-X configuration. Copy to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (omit DATABASE_URL to use the local SQLite file at instance/userdata.db)
# Supabase example (pooled connection, works over IPv4):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Session cookie SameSite policy (Lax / Strict / None)
SESSION_COOKIE_SAMESITE=Lax

# fiT-X AI coach — get a key at https://aistudio.google.com/
# Leave GEMINI_API_KEY empty to use the built-in rule-based coach instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Workout reminder emails. Priority: Gmail/SMTP -> Resend -> dry-run (logged).
# Gmail: create the account, enable 2-Step Verification, then generate an
# App Password at https://myaccount.google.com/apppasswords (the login
# password will NOT work here). ~500 emails/day on a free Gmail.
# NOTE: Render's free tier blocks outbound SMTP ports, so on Render the app
# automatically falls back to Resend (HTTPS). SMTP works locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=

# Alternative sender (no domain needed, but can only deliver to the Resend
# account's own email until you verify a domain).
RESEND_API_KEY=
RESEND_FROM=fiT-X <onboarding@resend.dev>

# Shared secret for the scheduler -> /cron/send-reminders trigger.
# Must match the FITX_CRON_SECRET repo secret used by .github/workflows/reminders.yml
CRON_SECRET=
